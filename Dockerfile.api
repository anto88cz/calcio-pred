# Stage 1: Builder
FROM node:18-alpine AS builder

WORKDIR /app

# Copia package files
COPY package*.json ./
COPY tsconfig.json ./

# Installa tutte le dipendenze (incluse devDependencies per build)
RUN npm install

# Copia il resto del codice
COPY prisma ./prisma
COPY src ./src

# Genera Prisma Client
RUN npx prisma generate

# Compila TypeScript
RUN npm run build

# Stage 2: Runner
FROM node:18-alpine AS runner

WORKDIR /app

# Installa wget per healthcheck e openssl per Prisma
RUN apk add --no-cache wget openssl

# Copia solo production dependencies
COPY package*.json ./
RUN npm install --only=production

# Copia Prisma schema e genera client
COPY prisma ./prisma
RUN npx prisma generate

# Copia il codice compilato dal builder
COPY --from=builder /app/dist ./dist

# Crea user non-root
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

USER nodejs

EXPOSE 3001

# Avvia direttamente il server (le migrazioni sono già state eseguite)
CMD ["node", "dist/server.js"]
