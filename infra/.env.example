# ==================================
# Docker Compose Environment Variables
# ==================================
# Copia questo file in .env nella stessa cartella (infra/.env)
# e configura le tue credenziali API-FOOTBALL

# API-FOOTBALL Configuration
APIFOOTBALL_BASE=https://v3.football.api-sports.io
APIFOOTBALL_KEY=your_api_key_here

# Parametri Calcolo
HISTORY_GAMES=20
HOME_ADV_GOALS=0.20
CONFIDENCE_MIN=0.60
BLEND_EMPIRIC=0.6
BLEND_POISSON=0.4

# Configurazione
TZ=Europe/Rome
CRON_ENABLED=true
LOG_LEVEL=info
