# ==================================
# Frontend Configuration
# ==================================
# NOTA: Il frontend non ha configurazioni sensibili.
# La password di autenticazione viene letta dal backend API.

# URL del backend API
NEXT_PUBLIC_API_URL=http://localhost:3001

# ==================================
# IMPORTANTE
# ==================================
# Per cambiare la password di accesso, modifica il file:
# ../api/.env
# 
# Variabile da modificare:
# NEXT_PUBLIC_APP_PASSWORD=tua_password_qui
#
# Il frontend la recupererà automaticamente tramite /api/auth/config
