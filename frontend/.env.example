# ==================================
# API Backend URL
# ==================================
NEXT_PUBLIC_API_URL=http://localhost:3001

# ==================================
# Authentication
# ==================================
# Password per accedere all'applicazione
# IMPORTANTE: Cambia questa password in produzione!
NEXT_PUBLIC_APP_PASSWORD=calcio2025

# ==================================
# App Configuration
# ==================================
NEXT_PUBLIC_APP_NAME=Calcio-Pred
NEXT_PUBLIC_APP_VERSION=1.0.0

# ==================================
# Features Toggle
# ==================================
# Mostrare solo badge GIOCALA di default
NEXT_PUBLIC_DEFAULT_FILTER_GIOCALA=false

# Mostrare grafici dettagliati
NEXT_PUBLIC_SHOW_CHARTS=true

# ==================================
# UI Configuration
# ==================================
# Refresh automatico ogni N secondi (0 per disabilitare)
NEXT_PUBLIC_AUTO_REFRESH_SECONDS=0

# Numero massimo di partite da mostrare per pagina
NEXT_PUBLIC_MATCHES_PER_PAGE=50
