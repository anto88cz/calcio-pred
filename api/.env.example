# ==================================
# API-FOOTBALL Configuration
# ==================================
# Registrati su https://www.api-football.com/ per ottenere la tua API key
APIFOOTBALL_BASE=https://v3.football.api-sports.io
APIFOOTBALL_KEY=your_api_key_here

# ==================================
# Database Configuration
# ==================================
DATABASE_URL=postgresql://calciopred:calciopred123@localhost:5432/calciopred?schema=public

# ==================================
# Redis Configuration
# ==================================
REDIS_URL=redis://localhost:6379

# ==================================
# Server Configuration
# ==================================
PORT=3001
NODE_ENV=development

# ==================================
# Parametri Calcolo Predizioni
# ==================================
# Numero di partite storiche da analizzare per ogni squadra
HISTORY_GAMES=20

# Vantaggio casa in gol (aggiunto a lambda_home nel Poisson)
HOME_ADV_GOALS=0.20

# Soglia minima di confidence per badge GIOCALA (0-1)
CONFIDENCE_MIN=0.60

# Peso dell'analisi Empirica nella media finale (0-1)
BLEND_EMPIRIC=0.6

# Peso del modello Poisson nella media finale (0-1)
BLEND_POISSON=0.4

# ==================================
# xG (Expected Goals) Parameters
# ==================================
# Peso xG nel blending con lambda storico (0-1)
# 0.30 = 30% xG, 70% storico
XG_BLEND_WEIGHT=0.30

# Soglia divergenza per flag lowXgConsistency (0-1)
# 0.60 = divergenza > 60% tra xG e storico
XG_DIVERGENCE_THRESHOLD=0.60

# Soglia xG totale per declassare Over/BTTS
# Se xgHome + xgAway <= 2.3 → declassa Over 1.5 e BTTS
XG_MIN_TOTAL=2.3

# Soglia xG alta per aumentare Over
# Se xgHome >= 1.8 o xgAway >= 1.8 → aumenta propensione Over
XG_HIGH_THRESHOLD=1.8

# ==================================
# Timezone
# ==================================
TZ=Europe/Rome

# ==================================
# Cache Configuration
# ==================================
# Tempo di cache per fixtures (in secondi)
CACHE_FIXTURES_TTL=3600

# Tempo di cache per predizioni (in secondi)
CACHE_PREDICTIONS_TTL=1800

# ==================================
# Logging
# ==================================
LOG_LEVEL=info
# Opzioni: trace, debug, info, warn, error, fatal

# ==================================
# Soglie Classificazione Forza
# ==================================
# Soglie per mercato 1X2
THRESHOLD_1X2_STRONG=50
THRESHOLD_1X2_MEDIUM=42
THRESHOLD_GIOCALA=80

# Soglie per mercati binari (Under/Over, BTTS)
THRESHOLD_BINARY_STRONG=62
THRESHOLD_BINARY_MEDIUM=55

# Soglie per Doppia Chance
THRESHOLD_DC_STRONG=75
THRESHOLD_DC_MEDIUM=65

# ==================================
# Job Scheduler Configuration
# ==================================
# Abilitare i job automatici
CRON_ENABLED=true

# Orario caricamento partite giornaliere (formato cron: minuti ore)
CRON_DAILY_FIXTURES=0 6

# Anticipo in minuti per refresh lineup/infortuni pre-partita
CRON_LINEUP_REFRESH_MINUTES=120

# Anticipo in minuti per update finale pre-partita
CRON_FINAL_UPDATE_MINUTES=30

# ==================================
# Rate Limiting API-FOOTBALL
# ==================================
# Numero massimo di richieste al minuto (piano free: 10/min)
API_RATE_LIMIT_PER_MINUTE=10

# Delay tra richieste in ms
API_REQUEST_DELAY=6000

# ==================================
# Data Validation
# ==================================
# Escludere partite amichevoli
EXCLUDE_FRIENDLIES=true

# Considerare solo partite ufficiali concluse
ONLY_OFFICIAL_RESULTS=true

# Tempo minimo di gioco richiesto (in minuti)
MIN_MATCH_TIME=90
